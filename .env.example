# Copy this file to .env (UTF-8 plain text). Never commit the real .env.

# DeepSeek: OpenAI-compatible chat completions API.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=0
DEEPSEEK_TIMEOUT_SECONDS=180
DEEPSEEK_MAX_TOKENS=5000

# OCR provider: none | aistudio | baidu_cloud
OCR_PROVIDER=none
OCR_MODE=auto
OCR_DPI=220
OCR_MAX_PAGES_PER_DOCUMENT=30

# AI Studio PaddleOCR-VL asynchronous Jobs API.
AISTUDIO_API_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
AISTUDIO_ACCESS_TOKEN=
AISTUDIO_AUTH_SCHEME=bearer
AISTUDIO_REQUEST_STYLE=paddleocr_job
AISTUDIO_MODEL=PaddleOCR-VL-1.6
AISTUDIO_POLL_INTERVAL_SECONDS=5
AISTUDIO_POLL_TIMEOUT_SECONDS=1800
AISTUDIO_TIMEOUT_SECONDS=180

# Optional: protect the local/public Web UI with HTTP Basic authentication.
# Leave both empty for localhost-only use. Never commit a real password.
FIN_AGENT_WEB_USERNAME=
FIN_AGENT_WEB_PASSWORD=

# Alternative: Baidu Intelligent Cloud OCR (API Key + Secret Key).
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
BAIDU_OCR_ENDPOINT=https://aip.baidubce.com/rest/2.0/ocr/v1/accurate_basic
BAIDU_OCR_TIMEOUT_SECONDS=120

# Semicolon-separated directories that the CLI/web UI may read.
# The project-local 财报数据 directory is always included for Web imports.
FIN_AGENT_DATA_ROOTS=财报数据;../财报分析;../年报

# Controlled local external evidence (.json/.csv/.md/.txt).
FIN_AGENT_EXTERNAL_EVIDENCE_DIR=external_evidence

# Optional override. Defaults to ./outputs.
FIN_AGENT_OUTPUT_DIR=outputs
